<!DOCTYPE html>
<html>

<head>
    <title>Password</title>
</head>

<body>

    <h1>Password required</h1>

    <form action="<%= page %>" method="GET">

        <input
            type="password"
            name="password"
            placeholder="Password"
            required
        >

        <button type="submit">
            Enter
        </button>

    </form>

</body>

</html>